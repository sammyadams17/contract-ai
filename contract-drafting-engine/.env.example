# One provider. Azure OpenAI wins when its endpoint is set.
DRAFTING_AZURE_OPENAI_ENDPOINT=
DRAFTING_AZURE_OPENAI_DEPLOYMENT=
DRAFTING_AZURE_OPENAI_API_VERSION=2025-04-01-preview
DRAFTING_AZURE_OPENAI_API_KEY=

OPENAI_API_KEY=
DRAFTING_MODEL=

# Limits shared by every draft in one process. 0 is no limit.
DRAFTING_LLM_TOKENS_PER_MINUTE=0
DRAFTING_LLM_CONCURRENCY=0
DRAFTING_REASONING_EFFORT=none
